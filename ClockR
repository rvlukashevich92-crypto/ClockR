import sys
import ctypes
from ctypes import wintypes

from PyQt6.QtCore import Qt, QTimer, QTime, QDate, QLocale, QPoint, QSettings
from PyQt6.QtGui import QFont, QKeyEvent
from PyQt6.QtWidgets import (
    QApplication, QWidget, QLabel, QVBoxLayout, QHBoxLayout,
    QPushButton, QCheckBox, QSlider, QFrame,
)

IS_WINDOWS = sys.platform == "win32"


class WindowsWindowHelper:
    """Дополнительные стили окна Windows через WinAPI."""

    GWL_EXSTYLE = -20
    WS_EX_LAYERED = 0x00080000
    WS_EX_TRANSPARENT = 0x00000020
    WS_EX_NOACTIVATE = 0x08000000
    SWP_NOSIZE = 0x0001
    SWP_NOMOVE = 0x0002
    SWP_NOACTIVATE = 0x0010
    HWND_BOTTOM = 1
    HWND_TOPMOST = -1
    HWND_NOTOPMOST = -2

    def __init__(self):
        self.user32 = ctypes.windll.user32 if IS_WINDOWS else None
        if not self.user32:
            return

        if ctypes.sizeof(ctypes.c_void_p) == 8:
            self.get_long = self.user32.GetWindowLongPtrW
            self.set_long = self.user32.SetWindowLongPtrW
        else:
            self.get_long = self.user32.GetWindowLongW
            self.set_long = self.user32.SetWindowLongW

        self.get_long.argtypes = [wintypes.HWND, ctypes.c_int]
        self.get_long.restype = ctypes.c_ssize_t
        self.set_long.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_ssize_t]
        self.set_long.restype = ctypes.c_ssize_t

        self.user32.SetWindowPos.argtypes = [
            wintypes.HWND, wintypes.HWND, ctypes.c_int, ctypes.c_int,
            ctypes.c_int, ctypes.c_int, wintypes.UINT,
        ]
        self.user32.SetWindowPos.restype = wintypes.BOOL

    def set_click_through(self, hwnd: int, enabled: bool):
        if not self.user32:
            return

        style = self.get_long(hwnd, self.GWL_EXSTYLE)
        style |= self.WS_EX_LAYERED
        
        if enabled:
            style |= self.WS_EX_TRANSPARENT | self.WS_EX_NOACTIVATE
        else:
            style &= ~(self.WS_EX_TRANSPARENT | self.WS_EX_NOACTIVATE)

        self.set_long(hwnd, self.GWL_EXSTYLE, style)
        # Удерживаем окно поверх всех (HWND_TOPMOST), чтобы оно не улетало под рабочий стол
        self.user32.SetWindowPos(
            hwnd, self.HWND_TOPMOST, 0, 0, 0, 0,
            self.SWP_NOMOVE | self.SWP_NOSIZE | self.SWP_NOACTIVATE,
        )

    def set_z_order(self, hwnd: int, mode: str):
        if not self.user32:
            return
        insert_after = {
            "top": self.HWND_TOPMOST,
            "bottom": self.HWND_BOTTOM,
            "normal": self.HWND_NOTOPMOST,
        }.get(mode, self.HWND_TOPMOST)
        
        self.user32.SetWindowPos(
            hwnd, insert_after, 0, 0, 0, 0,
            self.SWP_NOMOVE | self.SWP_NOSIZE | self.SWP_NOACTIVATE,
        )


class TransparentClock(QWidget):
    def __init__(self):
        super().__init__()
        self.settings = QSettings("DesktopTools", "TransparentClock")
        self.win_helper = WindowsWindowHelper()
        self.drag_position: QPoint | None = None
        self._topmost = True

        self.setWindowTitle("Прозрачные часы")
        # Добавлен флаг WindowStaysOnTopHint по умолчанию
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.Tool | Qt.WindowType.WindowStaysOnTopHint | Qt.WindowType.CustomizeWindowHint)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)

        self._build_ui()
        self._restore_settings()

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_datetime)
        self.timer.start(1000)
        self.update_datetime()

    def _build_ui(self):
        self.title_bar = QFrame(self)
        self.title_bar.setFixedHeight(32)
        self.title_bar.setStyleSheet(
            "QFrame { background-color: rgba(30,30,30,210); "
            "border-top-left-radius: 10px; border-top-right-radius: 10px; }"
        )

        self.title_label = QLabel("Часы", self.title_bar)
        self.title_label.setStyleSheet("color: white; font: bold 14px;")

        self.mode_button = QPushButton("Поверх", self.title_bar)
        self.mode_button.setToolTip("Переключить расположение окна")
        self.mode_button.setFixedHeight(25)
        self.mode_button.setStyleSheet(
            "QPushButton { color:white; background:rgba(255,255,255,25); "
            "border:1px solid rgba(255,255,255,60); border-radius:5px; padding:2px 7px; }"
            "QPushButton:hover { background:rgba(255,255,255,55); }"
        )
        self.mode_button.clicked.connect(self.toggle_z_order)

        self.close_button = QPushButton("✕", self.title_bar)
        self.close_button.setFixedSize(30, 30)
        self.close_button.setStyleSheet(
            "QPushButton { color:white; background:transparent; border:none; }"
            "QPushButton:hover { background:rgba(220,50,50,180); }"
        )
        self.close_button.clicked.connect(self.close)

        title_layout = QHBoxLayout(self.title_bar)
        title_layout.setContentsMargins(8, 0, 5, 0)
        title_layout.setSpacing(6)
        title_layout.addWidget(self.title_label)
        title_layout.addStretch()
        title_layout.addWidget(self.mode_button)
        title_layout.addWidget(self.close_button)

        self.time_label = QLabel(self)
        self.time_label.setFont(QFont("Courier New", 70, QFont.Weight.Bold))
        self.time_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.time_label.setStyleSheet(
            "color:white; background-color:rgba(0,0,0,100); "
            "border-radius:10px; padding:4px 10px;"
        )

        self.date_label = QLabel(self)
        self.date_label.setFont(QFont("Courier New", 20))
        self.date_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.date_label.setStyleSheet(
            "color:white; background-color:rgba(0,0,0,80); "
            "border-radius:8px; padding:6px;"
        )

        self.click_through_checkbox = QCheckBox("Сквозные клики (Windows)")
        self.click_through_checkbox.setStyleSheet("color:white;")
        self.click_through_checkbox.setToolTip(
            "Клики будут передаваться окнам под часами.\n"
            "Чтобы вернуть управление, выберите окно на панели задач и нажмите ESC."
        )
        self.click_through_checkbox.toggled.connect(self.set_click_through)

        self.opacity_label = QLabel("Прозрачность окна: 100%")
        self.opacity_label.setStyleSheet("color:white;")
        self.opacity_slider = QSlider(Qt.Orientation.Horizontal)
        self.opacity_slider.setRange(30, 100)
        self.opacity_slider.setValue(100)
        self.opacity_slider.valueChanged.connect(self.set_opacity)

        self.options_panel = QWidget(self)
        self.options_panel.setStyleSheet(
            "background-color:rgba(30,30,30,190); border-radius:8px;"
        )
        options_layout = QVBoxLayout(self.options_panel)
        options_layout.setContentsMargins(10, 6, 10, 8)
        options_layout.addWidget(self.click_through_checkbox)
        options_layout.addWidget(self.opacity_label)
        options_layout.addWidget(self.opacity_slider)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(3)
        layout.addWidget(self.title_bar)
        layout.addWidget(self.time_label)
        layout.addWidget(self.date_label)
        layout.addWidget(self.options_panel)
        self.resize(350, 225)
        self.size_label = QLabel("Размер окна: 100%")
        self.size_label.setStyleSheet("color:white;")
        self.size_slider = QSlider(Qt.Orientation.Horizontal)
        self.size_slider.setRange(50, 200)  # Меняет размер от 50% до 200%
        self.size_slider.setValue(100)
        self.size_slider.valueChanged.connect(self.change_window_size)

        # Добавляем в ту же панель, где лежит прозрачность
        options_layout.addWidget(self.size_label)
        options_layout.addWidget(self.size_slider)

    def update_datetime(self):
        current_time = QTime.currentTime().toString("HH:mm:ss")
        current_date = QLocale(QLocale.Language.Russian).toString(QDate.currentDate(), "dddd, d MMMM yyyy")
        self.time_label.setText(current_time)
        self.date_label.setText(current_date)

    def set_opacity(self, value: int):
        self.setWindowOpacity(value / 100.0)
        self.opacity_label.setText(f"Прозрачность окна: {value}%")

    def change_window_size(self, percent: int):
        # 1. Меняем размер самого окна (базовый 440x275)
        new_width = int(440 * (percent / 100.0))
        new_height = int(275 * (percent / 100.0))
        self.resize(new_width, new_height)
        self.size_label.setText(f"Размер окна: {percent}%")

        # 2. Пропорционально меняем размер шрифта времени (базовый 70)
        time_font_size = int(70 * (percent / 100.0))
        self.time_label.setFont(QFont("Courier New", time_font_size, QFont.Weight.Bold))

        # 3. Пропорционально меняем размер шрифта даты (базовый 20)
        date_font_size = int(20 * (percent / 100.0))
        self.date_label.setFont(QFont("Courier New", date_font_size))

    def set_click_through(self, enabled: bool):
        if IS_WINDOWS and self.windowHandle():
            hwnd = int(self.windowHandle().winId())
            self.win_helper.set_click_through(hwnd, enabled)

    def toggle_z_order(self):
        self._topmost = not self._topmost
        self.mode_button.setText("Поверх" if self._topmost else "Рабочий стол")
        if IS_WINDOWS and self.windowHandle():
            hwnd = int(self.windowHandle().winId())
            mode = "top" if self._topmost else "normal"
            self.win_helper.set_z_order(hwnd, mode)

    def _restore_settings(self):
        x = self.settings.value("x", 100, type=int)
        y = self.settings.value("y", 100, type=int)
        width = self.settings.value("width", 350, type=int)
        height = self.settings.value("height", 200, type=int)
        opacity = self.settings.value("opacity", 75, type=int)
        self._topmost = self.settings.value("topmost", True, type=bool)

        self.resize(max(width, 200), max(height, 100))
        self.move(x, y)
        self.opacity_slider.setValue(max(30, min(opacity, 100)))
        # Галочка сквозных кликов при старте принудительно отключена
        self.click_through_checkbox.setChecked(False)
        self.mode_button.setText("Поверх" if self._topmost else "Рабочий стол")
        saved_size = self.settings.value("window_scale", 100, type=int)
        self.size_slider.setValue(saved_size)

    def showEvent(self, event):
        super().showEvent(event)
        self._apply_native_styles()

    def _apply_native_styles(self):
        if not IS_WINDOWS or not self.windowHandle():
            return
        hwnd = int(self.windowHandle().winId())
        self.win_helper.set_click_through(hwnd, self.click_through_checkbox.isChecked())
        mode = "top" if self._topmost else "normal"
        self.win_helper.set_z_order(hwnd, mode)

    def closeEvent(self, event):
        self.settings.setValue("x", self.x())
        self.settings.setValue("y", self.y())
        self.settings.setValue("width", self.width())
        self.settings.setValue("height", self.height())
        self.settings.setValue("opacity", self.opacity_slider.value())
        self.settings.setValue("topmost", self._topmost)
        self.settings.setValue("click_through", self.click_through_checkbox.isChecked())
        self.settings.setValue("window_scale", self.size_slider.value())
        super().closeEvent(event)
        

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            if self.title_bar.geometry().contains(event.position().toPoint()):
                self.drag_position = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
                event.accept()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.MouseButton.LeftButton and self.drag_position is not None:
            self.move(event.globalPosition().toPoint() - self.drag_position)
            event.accept()

    def mouseReleaseEvent(self, event):
        self.drag_position = None

    def keyPressEvent(self, event: QKeyEvent):
        if event.key() == Qt.Key.Key_Escape:
            if self.click_through_checkbox.isChecked():
                self.click_through_checkbox.setChecked(False)
                event.accept()
        super().keyPressEvent(event)

    

if __name__ == "__main__":
    app = QApplication(sys.argv)
    clock = TransparentClock()
    clock.show()
    sys.exit(app.exec())
